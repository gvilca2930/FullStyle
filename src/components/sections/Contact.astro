---
import { Icon } from 'astro-icon/components';
import type { Business } from '../../types/business';
import { createTelUrl } from '../../utils/formatting';
interface Props { business: Business; whatsappUrl: string; }
const { business, whatsappUrl } = Astro.props;
const primaryHours = business.openingHours.toSorted((a, b) => a.order - b.order)[0];
const items = [
  { label: 'WhatsApp', value: business.phone, href: whatsappUrl, icon: 'lucide:message-circle', external: true },
  { label: 'Teléfono', value: business.phone, href: createTelUrl(business.phone), icon: 'lucide:phone', external: false },
  { label: 'Correo', value: business.email, href: `mailto:${business.email}`, icon: 'lucide:mail', external: false },
];
---

<section class="section-space bg-background">
  <div class="site-container">
    <div class="grid overflow-hidden rounded-xl border border-border bg-surface shadow-card lg:grid-cols-[0.85fr_1.15fr]">
      <div class="border-b border-border p-7 sm:p-10 lg:border-b-0 lg:border-r">
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Hablemos</p><h2 class="mt-3 font-heading text-3xl font-bold text-text-primary sm:text-4xl">Contacto</h2><p class="mt-4 leading-7 text-text-secondary">Consulta servicios, productos y disponibilidad por el canal que prefieras.</p>
        {primaryHours && <div class="mt-8 flex items-center gap-3 text-sm text-text-secondary"><Icon name="lucide:clock-3" class="text-primary" size={19} aria-hidden="true" /><span>{primaryHours.days} · {primaryHours.hours}</span></div>}
      </div>
      <div class="grid sm:grid-cols-3">
        {items.map(({ label, value, href, icon: iconName, external }) => <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="group flex min-w-0 flex-col justify-between border-b border-border p-6 transition-colors duration-200 hover:bg-surface-elevated focus-outline last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0"><Icon name={iconName} class="text-primary" size={22} aria-hidden="true" /><div class="mt-12 min-w-0"><p class="text-xs font-bold uppercase tracking-[0.16em] text-text-muted">{label}</p><p class="mt-2 break-words text-sm font-semibold text-text-primary transition-colors duration-200 group-hover:text-primary">{value}</p></div></a>)}
      </div>
    </div>
  </div>
</section>
