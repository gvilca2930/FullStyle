---
import { MessageCircle } from '@lucide/astro';
interface Props { whatsappUrl: string; }
const { whatsappUrl } = Astro.props;
---

<section class="final-cta relative overflow-hidden border-b border-background/30 py-9 text-text-on-primary sm:py-11 lg:py-12">
  <div class="final-cta-pattern" aria-hidden="true"></div>
  <div class="site-container relative flex max-w-5xl flex-col items-start justify-between gap-6 md:flex-row md:items-center md:gap-10">
    <div><h2 class="font-heading text-2xl font-black tracking-tight sm:text-3xl lg:text-4xl">¿Listo para renovar tu estilo?</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-text-on-primary/70 sm:text-base">Escríbenos por WhatsApp y consulta nuestros servicios y disponibilidad.</p></div>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="final-cta-button inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-full bg-background px-6 py-3 text-sm font-bold text-text-primary shadow-card transition duration-300 hover:-translate-y-0.5 hover:bg-background-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-background sm:w-auto"><MessageCircle class="final-cta-icon" size={18} aria-hidden="true" />Contactar por WhatsApp</a>
  </div>
</section>

<style>
  .final-cta {
    background:
      linear-gradient(to bottom, transparent 68%, color-mix(in srgb, var(--color-background) 14%, transparent)),
      linear-gradient(120deg, var(--color-primary-hover), var(--color-primary) 56%, var(--color-primary-active));
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--color-background) 32%, transparent);
  }

  .final-cta-pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(115deg, transparent 0 43px, color-mix(in srgb, var(--color-text-on-primary) 7%, transparent) 44px 45px);
    pointer-events: none;
  }

  .final-cta-button {
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
  }

  .final-cta-icon {
    transition: transform 0.25s ease;
  }

  .final-cta-button:hover .final-cta-icon {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .final-cta-icon {
      transform: none;
      transition: none;
    }
  }
</style>
