---
import { MessageCircle } from '@lucide/astro';
interface Props { whatsappUrl: string; }
const { whatsappUrl } = Astro.props;
---

<section class="relative overflow-hidden bg-primary py-16 text-text-on-primary sm:py-20">
  <div class="cta-lines" aria-hidden="true"></div>
  <div class="site-container relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <div><h2 class="font-heading text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">¿Listo para renovar tu estilo?</h2><p class="mt-3 max-w-2xl text-text-on-primary/70">Escríbenos por WhatsApp y consulta nuestros servicios y disponibilidad.</p></div>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-background px-6 py-3.5 text-sm font-bold text-text-primary shadow-card transition duration-200 hover:-translate-y-0.5 hover:bg-background-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-background"><MessageCircle size={18} aria-hidden="true" />Contactar por WhatsApp</a>
  </div>
</section>
