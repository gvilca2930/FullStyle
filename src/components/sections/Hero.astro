---
import { ArrowDown, Check, MessageCircle, Scissors } from '@lucide/astro';
import type { Business } from '../../types/business';
import MediaPlaceholder from '../ui/MediaPlaceholder.astro';
interface Props { business: Business; bookingUrl: string; }
const { business, bookingUrl } = Astro.props;
const benefits = ['Cortes especializados', 'Atención personalizada', 'Estilo profesional'];
---

<section id="inicio" class="hero-shell relative overflow-hidden border-b border-border bg-background">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-spotlight" aria-hidden="true"></div>
  <div class="site-container relative grid items-center gap-12 py-14 sm:py-16 lg:min-h-[calc(100svh-5rem)] lg:grid-cols-[1.02fr_0.98fr] lg:gap-14 lg:py-12">
    <div class="relative z-10">
      <div class="hero-reveal hero-delay-1 mb-6 inline-flex items-center gap-2 rounded-full border border-border-strong bg-primary-subtle px-3 py-2 text-xs font-bold uppercase tracking-[0.18em] text-primary">
        <Scissors size={15} aria-hidden="true" /> Barbería profesional en Arequipa
      </div>
      <p class="hero-reveal hero-delay-2 font-heading text-sm font-bold tracking-[0.42em] text-text-muted sm:text-base">{business.name}</p>
      <h1 class="hero-reveal hero-delay-3 mt-4 max-w-3xl font-heading text-4xl font-black leading-[1.04] tracking-tight text-text-primary sm:text-6xl lg:text-[clamp(3.25rem,7vh,5rem)]">{business.slogan}</h1>
      <p class="hero-reveal hero-delay-4 mt-6 max-w-xl text-base leading-8 text-text-secondary sm:text-lg">{business.description}</p>
      <div class="hero-reveal hero-delay-5 mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="hero-cta button-primary"><MessageCircle class="hero-cta-icon" size={18} aria-hidden="true" />Reservar por WhatsApp</a>
        <a href="#servicios" class="hero-cta button-secondary">Ver servicios<ArrowDown class="hero-cta-icon" size={18} aria-hidden="true" /></a>
      </div>
      <ul class="mt-8 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:flex-wrap sm:gap-x-6">
        {benefits.map((benefit, index) => <li class:list={["hero-reveal flex items-center gap-2 text-sm text-text-secondary", `hero-benefit-${index + 1}`]}><span class="grid size-5 place-items-center rounded-full bg-primary-subtle text-primary"><Check size={12} stroke-width={3} aria-hidden="true" /></span>{benefit}</li>)}
      </ul>
    </div>
    <div class="hero-visual hero-image-reveal relative min-h-[430px] sm:min-h-[560px] lg:h-[min(72vh,46rem)] lg:min-h-[34rem]" data-hero-visual>
      <div class="hero-image-frame absolute inset-5 translate-x-3 translate-y-3 rounded-xl border border-border-strong" aria-hidden="true"></div>
      <div class="hero-media absolute inset-0">
        {business.heroImage ? <img src={business.heroImage} alt={`Interior de la barbería ${business.name} en Arequipa`} width="1080" height="1920" fetchpriority="high" class="h-full w-full rounded-xl border border-border bg-surface object-cover shadow-card" /> : <MediaPlaceholder label="Imagen principal del local" class="h-full min-h-[430px] rounded-xl border border-border bg-surface lg:min-h-0" />}
      </div>
      <div class="specialty-card hero-card-reveal absolute -bottom-3 left-4 rounded-xl border border-border-strong bg-background/90 px-5 py-4 backdrop-blur sm:-left-5 sm:px-6">
        <p class="text-xs uppercase tracking-[0.2em] text-text-muted">Especialidad</p>
        <p class="mt-1 font-heading text-lg font-bold text-text-primary">Cortes & barbería</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-shell::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 76% 34%, color-mix(in srgb, var(--color-primary) 9%, transparent), transparent 34%),
      linear-gradient(115deg, transparent 38%, color-mix(in srgb, var(--color-primary) 2.5%, transparent) 70%, transparent);
    content: '';
    pointer-events: none;
  }

  .hero-spotlight {
    position: absolute;
    top: 12%;
    right: 7%;
    width: min(38rem, 54vw);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-radius: 50%;
    opacity: 0.45;
    filter: blur(1px);
    mask-image: linear-gradient(to bottom, black, transparent 76%);
    pointer-events: none;
  }

  .hero-reveal,
  .hero-image-reveal,
  .hero-card-reveal {
    opacity: 0;
    animation: hero-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-reveal {
    transform: translateY(12px);
  }

  .hero-delay-1 { animation-delay: 0.06s; }
  .hero-delay-2 { animation-delay: 0.12s; }
  .hero-delay-3 { animation-delay: 0.18s; }
  .hero-delay-4 { animation-delay: 0.24s; }
  .hero-delay-5 { animation-delay: 0.3s; }
  .hero-benefit-1 { animation-delay: 0.38s; }
  .hero-benefit-2 { animation-delay: 0.44s; }
  .hero-benefit-3 { animation-delay: 0.5s; }

  .hero-image-reveal {
    animation-delay: 0.16s;
    transform: translateY(14px) scale(0.985);
  }

  .hero-media {
    transform: translate3d(var(--hero-shift-x, 0), var(--hero-shift-y, 0), 0) scale(1.005);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .hero-image-frame {
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease;
  }

  .hero-visual:hover .hero-image-frame {
    border-color: var(--color-primary);
    transform: translate(0.875rem, 0.875rem);
  }

  .hero-card-reveal {
    animation-delay: 0.52s;
    box-shadow: 0 18px 55px rgb(0 0 0 / 0.42), 0 0 28px color-mix(in srgb, var(--color-primary) 8%, transparent);
    transform: translateY(10px);
  }

  .hero-cta-icon {
    transition: transform 0.25s ease;
  }

  .hero-cta:hover .hero-cta-icon {
    transform: translate(2px, -1px);
  }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 639px) {
    .hero-spotlight {
      top: 48%;
      right: -25%;
      width: 30rem;
      opacity: 0.28;
    }

    .hero-reveal {
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-image-reveal,
    .hero-card-reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-media,
    .hero-image-frame,
    .hero-cta-icon {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  let animationFrame = 0;

  const resetImagePosition = () => {
    if (!visual) return;
    visual.style.setProperty('--hero-shift-x', '0px');
    visual.style.setProperty('--hero-shift-y', '0px');
  };

  visual?.addEventListener('pointermove', (event) => {
    if (reduceMotion.matches || !finePointer.matches) return;
    const bounds = visual.getBoundingClientRect();
    const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 8;
    const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 8;

    cancelAnimationFrame(animationFrame);
    animationFrame = requestAnimationFrame(() => {
      visual.style.setProperty('--hero-shift-x', `${x.toFixed(2)}px`);
      visual.style.setProperty('--hero-shift-y', `${y.toFixed(2)}px`);
    });
  });

  visual?.addEventListener('pointerleave', resetImagePosition);
  reduceMotion.addEventListener('change', resetImagePosition);
</script>
