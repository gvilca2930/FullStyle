---
import { ArrowUpRight, Package, Star } from '@lucide/astro';
import type { Product } from '../../types/product';
import MediaPlaceholder from './MediaPlaceholder.astro';
interface Props { product: Product; enquiryUrl: string; }
const { product, enquiryUrl } = Astro.props;
const imagePosition = product.imagePosition ?? 'center';
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface shadow-card transition duration-300 hover:-translate-y-1 hover:border-border-strong hover:shadow-card-hover">
  <div class="relative overflow-hidden border-b border-border">
    {product.image ? <img src={product.image} alt={product.imageAlt ?? product.name} loading="lazy" width="800" height="800" style={`object-position: ${imagePosition};`} class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]" /> : <MediaPlaceholder label="Imagen del producto" class="aspect-square bg-background-secondary" />}
    {product.featured && <span class="absolute left-4 top-4 inline-flex items-center gap-1 rounded-full bg-primary px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-text-on-primary"><Star size={11} fill="currentColor" aria-hidden="true" />Destacado</span>}
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="font-heading text-xl font-bold text-text-primary">{product.name}</h3>
    <p class="mt-2 flex-1 text-sm leading-6 text-text-secondary">{product.description}</p>
    <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4">
      <span class:list={["inline-flex items-center gap-1.5 text-xs font-medium", product.available ? "text-success" : "text-text-muted"]}><Package size={14} aria-hidden="true" />{product.available ? 'Disponible' : 'Agotado'}</span>
      <span class="text-xs font-medium text-primary/80 sm:text-sm">{product.priceLabel}</span>
    </div>
    <a href={enquiryUrl} target="_blank" rel="noopener noreferrer" aria-label={`Consultar ${product.name} por WhatsApp`} class="mt-5 inline-flex items-center justify-center gap-2 rounded-full border border-border px-4 py-2.5 text-sm font-bold text-text-primary transition duration-200 hover:border-border-strong hover:bg-primary-subtle hover:text-primary focus-outline">Consultar <ArrowUpRight size={17} aria-hidden="true" /></a>
  </div>
</article>
