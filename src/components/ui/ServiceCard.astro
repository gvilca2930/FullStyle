---
import { ArrowUpRight, Scissors, Star } from '@lucide/astro';
import type { Service } from '../../types/service';
import { formatPrice } from '../../utils/formatting';
import MediaPlaceholder from './MediaPlaceholder.astro';
interface Props { service: Service; bookingUrl: string; }
const { service, bookingUrl } = Astro.props;
---

<article class:list={["group relative flex h-full flex-col overflow-hidden rounded-xl border bg-surface shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-hover", service.featured ? "border-border-strong" : "border-border hover:border-border-strong"]}>
  {service.featured && <span class="absolute right-4 top-4 z-10 inline-flex items-center gap-1.5 rounded-full bg-primary px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-text-on-primary"><Star size={11} fill="currentColor" aria-hidden="true" />Destacado</span>}
  <div class="overflow-hidden border-b border-border">
    {service.image ? <img src={service.image} alt={service.name} loading="lazy" width="800" height="600" class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]" /> : <MediaPlaceholder label="Imagen del servicio" class="aspect-[16/9] bg-background-secondary" />}
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-primary-subtle text-primary"><Scissors size={19} aria-hidden="true" /></div>
      <p class="font-heading text-base font-bold text-primary">{service.price === null ? 'Precio a consultar' : formatPrice(service.price, service.currency)}</p>
    </div>
    <h3 class="mt-5 font-heading text-xl font-bold text-text-primary">{service.name}</h3>
    <p class="mt-2 flex-1 text-sm leading-6 text-text-secondary">{service.description}</p>
    <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center justify-between border-t border-border pt-4 text-sm font-bold text-text-primary transition-colors duration-200 group-hover:text-primary focus-outline">Reservar <ArrowUpRight size={17} aria-hidden="true" /></a>
  </div>
</article>
